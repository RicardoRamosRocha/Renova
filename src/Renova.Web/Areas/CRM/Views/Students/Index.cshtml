@using Renova.Domain.Entities
@using Renova.Web.Areas.CRM.ViewModels.Students
@using Renova.Web.ViewModels
@model StudentIndexViewModel

@{
    ViewData["Title"] = "Acolhidos";
    var statuses = Model.Statuses;
}

<section class="orizon-grid orizon-gap-6">
    <div class="orizon-card orizon-card--gradient orizon-card--padding-lg orizon-flex orizon-items-center orizon-justify-between orizon-gap-4">
        <div>
            <span class="orizon-badge orizon-badge--info orizon-badge--sm">CRM / Acolhidos</span>
            <h1>Acolhidos</h1>
            <p>Gerencie cadastros, admissões, vínculos familiares e acesso rápido ao perfil dos acolhidos.</p>
        </div>

        <a class="orizon-button orizon-button--solid orizon-button--primary orizon-button--md" asp-action="Create">
            
            Novo acolhido
        </a>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="orizon-alert orizon-alert--success">
            
            <span>@success</span>
        </div>
    }

    <div class="orizon-dashboard-grid is-auto-fit is-responsive">
        <article class="orizon-card orizon-card--elevated orizon-card--padding-md">
            <div class="metric-icon">
                
            </div>
            <span>Total</span>
            <strong>@Model.Total</strong>
            <small>Acolhidos cadastrados</small>
        </article>

        <article class="orizon-card orizon-card--elevated orizon-card--padding-md">
            <div class="metric-icon">
                
            </div>
            <span>Ativos</span>
            <strong>@Model.Active</strong>
            <small>Em operação</small>
        </article>

        <article class="orizon-card orizon-card--elevated orizon-card--padding-md">
            <div class="metric-icon">
                
            </div>
            <span>Em tratamento</span>
            <strong>@Model.InTreatment</strong>
            <small>Planos ativos</small>
        </article>

        <article class="orizon-card orizon-card--elevated orizon-card--padding-md">
            <div class="metric-icon">
                
            </div>
            <span>Altas previstas</span>
            <strong>@Model.DischargePlanned</strong>
            <small>Planejadas no CRM</small>
        </article>
    </div>

    <section class="orizon-card orizon-card--padding-none">
        <div class="orizon-command-bar orizon-flex orizon-items-center orizon-justify-between orizon-gap-4">
            <div>
                <span class="orizon-badge orizon-badge--info orizon-badge--sm">Lista</span>
                <h2>Cadastros de acolhidos</h2>
                <p>Visualize os acolhidos, status e ações principais.</p>
            </div>

            <form class="orizon-form-grid orizon-items-end" method="get">
                <div class="crm-search-box">
                    
                    <input class="orizon-input" name="search"
                           value="@Model.Search"
                           type="search"
                           placeholder="Buscar por nome, CPF, telefone ou email" />
                </div>

                <select class="orizon-select" name="status">
                    <option value="">Todos os status</option>
                    @foreach (var status in statuses)
                    {
                        <option value="@status.Key" selected="@(Model.Status == status.Key)">
                            @status.Value
                        </option>
                    }
                </select>

                <input class="orizon-input" name="admissionFrom" value="@Model.AdmissionFrom?.ToString("yyyy-MM-dd")" type="date" />
                <input class="orizon-input" name="admissionTo" value="@Model.AdmissionTo?.ToString("yyyy-MM-dd")" type="date" />

                <button class="orizon-button orizon-button--outline orizon-button--neutral orizon-button--md" type="submit" data-tooltip="Aplicar filtros">
                    
                    Filtrar
                </button>
            </form>
        </div>

        @if (Model.Students.Items.Count == 0)
        {
            <div class="orizon-empty-state orizon-card orizon-card--padding-lg">
                <div class="crm-empty-icon">
                    
                </div>

                <strong>Nenhum acolhido encontrado</strong>
                <p>Cadastre o primeiro acolhido ou ajuste os filtros de busca.</p>

                <a class="orizon-button orizon-button--solid orizon-button--primary orizon-button--md" asp-action="Create">
                    
                    Criar primeiro cadastro
                </a>
            </div>
        }
        else
        {
            <div class="orizon-table-container">
                <table class="orizon-table orizon-table--hoverable">
                    <thead>
                        <tr>
                            <th>Acolhido</th>
                            <th>CPF</th>
                            <th>Telefone</th>
                            <th>Entrada</th>
                            <th>Situação</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var student in Model.Students.Items)
                        {
                            var statusClass = student.Status == StudentStatuses.Inactive
                                ? "danger"
                                : student.Status == StudentStatuses.InTreatment
                                    ? "info"
                                    : student.Status == StudentStatuses.DischargePlanned
                                        ? "warn"
                                        : "ok";

                            <tr>
                                <td>
                                    <a class="renova-person-cell" asp-action="Details" asp-route-id="@student.Id">
                                        @await Html.PartialAsync("~/Views/Shared/_ProfileAvatar.cshtml", new ProfileAvatarViewModel
                                        {
                                            Name = student.Name,
                                            PhotoUrl = student.PhotoUrl
                                        })

                                        <span>
                                            <strong class="renova-row-title">@student.Name</strong>
                                            <small class="renova-row-subtitle">@StudentStatuses.Label(student.Status)</small>
                                        </span>
                                    </a>
                                </td>

                                <td>
                                    <span class="renova-muted">@student.Cpf</span>
                                </td>

                                <td>
                                    <span class="renova-muted">@student.Phone</span>
                                </td>

                                <td>
                                    <span class="renova-muted">@student.AdmissionDate.ToString("dd/MM/yyyy")</span>
                                    @if (!string.IsNullOrWhiteSpace(student.ResponsibleProfessional))
                                    {
                                        <small class="renova-row-subtitle">Resp. @student.ResponsibleProfessional</small>
                                    }
                                </td>

                                <td>
                                    <span class="orizon-badge orizon-badge--md @statusClass">
                                        @StudentStatuses.Label(student.Status)
                                    </span>
                                </td>

                                <td>
                                    <div class="orizon-flex orizon-gap-2">
                                        <a class="orizon-button orizon-button--ghost orizon-button--neutral orizon-button--sm"
                                           data-tooltip="Detalhes"
                                           asp-action="Details"
                                           asp-route-id="@student.Id">
                                            
                                        </a>

                                        <a class="orizon-button orizon-button--ghost orizon-button--neutral orizon-button--sm"
                                           data-tooltip="Editar"
                                           asp-action="Edit"
                                           asp-route-id="@student.Id">
                                            
                                        </a>

                                        <a class="orizon-button orizon-button--ghost orizon-button--danger orizon-button--sm"
                                           data-tooltip="Arquivar"
                                           href="#delete-student-@student.Id">
                                            
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @await Html.PartialAsync("~/Views/Shared/_Pagination.cshtml", Model.Students)

            @foreach (var student in Model.Students.Items)
            {
                <div id="delete-student-@student.Id" class="admin-delete-modal" role="dialog" aria-modal="true">
                    <div class="admin-delete-dialog">
                        <h2>Arquivar acolhido</h2>
                        <p>Deseja realmente arquivar este registro? Se houver vínculos, o acolhido será inativado com segurança.</p>

                        <div class="admin-delete-actions">
                            <a class="orizon-button orizon-button--outline orizon-button--neutral orizon-button--md" href="#">Cancelar</a>

                            <form asp-action="Delete" asp-route-id="@student.Id" method="post">
                                <button class="orizon-button orizon-button--solid orizon-button--danger orizon-button--md" type="submit">
                                    Arquivar
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </section>
</section>

