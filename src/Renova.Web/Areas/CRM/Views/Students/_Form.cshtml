@using Renova.Web.Areas.CRM.ViewModels.Students
@using Renova.Web.ViewModels
@model StudentFormViewModel

@{
    var isEdit = Model.Id.HasValue;
    var statusText = StudentStatuses.Label(Model.Status);
}

<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="PhotoPath" />

<div asp-validation-summary="ModelOnly" class="orizon-alert orizon-alert--danger"></div>

@await Html.PartialAsync("~/Views/Shared/_ProfileHeader.cshtml", new ProfileHeaderViewModel
{
    Name = Model.FullName,
    Subtitle = "Acolhido",
    Status = statusText,
    SupportingText = Model.AdmissionDate == default ? "Cadastro em andamento" : $"Entrada em {Model.AdmissionDate:dd/MM/yyyy}",
    PhotoUrl = Model.PhotoPath
})

<div class="admin-form-card">
    <section class="admin-form-section">
        <div class="admin-form-section-title">
            <div>
                <span class="rn-eyebrow">Dados pessoais</span>
                <h2>Identificação do acolhido</h2>
                <p>Dados usados para cadastro, acompanhamento e prontuário.</p>
            </div>
        </div>

        <div class="orizon-form-grid">
            <div class="orizon-field">
                <label class="orizon-field__label required" asp-for="FullName">Nome completo</label>
                <input class="orizon-input" asp-for="FullName" autocomplete="name" placeholder="Digite o nome completo" />
                <span class="orizon-field__error" asp-validation-for="FullName"></span>
            </div>

            <div class="orizon-field">
                <label class="orizon-field__label required" asp-for="CPF">CPF</label>
                <input class="orizon-input" asp-for="CPF" inputmode="numeric" placeholder="000.000.000-00" />
                <span class="orizon-field__error" asp-validation-for="CPF"></span>
            </div>

            <div class="orizon-field">
                <label class="orizon-field__label" asp-for="RG">RG</label>
                <input class="orizon-input" asp-for="RG" placeholder="Digite o RG" />
                <span class="orizon-field__error" asp-validation-for="RG"></span>
            </div>

            <div class="orizon-field">
                <label class="orizon-field__label required" asp-for="BirthDate">Data de nascimento</label>
                <input class="orizon-input" asp-for="BirthDate" type="date" />
                <span class="orizon-field__error" asp-validation-for="BirthDate"></span>
            </div>

            <div class="orizon-field">
                <label class="orizon-field__label required" asp-for="Status">Status</label>
                <select class="orizon-select" asp-for="Status">
                    @foreach (var status in StudentStatuses.Labels)
                    {
                        <option value="@status.Key">@status.Value</option>
                    }
                </select>
                <span class="orizon-field__error" asp-validation-for="Status"></span>
            </div>
        </div>
    </section>

    <section class="admin-form-section">
        <div class="admin-form-section-title">
            <div>
                <span class="rn-eyebrow">Contato</span>
                <h2>Canais de comunicação</h2>
                <p>Informações usadas pela equipe para contato rápido.</p>
            </div>
        </div>

        <div class="orizon-form-grid">
            <div class="orizon-field">
                <label class="orizon-field__label required" asp-for="Phone">Telefone</label>
                <input class="orizon-input" asp-for="Phone" inputmode="tel" autocomplete="tel" placeholder="(00) 00000-0000" />
                <span class="orizon-field__error" asp-validation-for="Phone"></span>
            </div>

            <div class="orizon-field">
                <label class="orizon-field__label" asp-for="WhatsApp">WhatsApp</label>
                <input class="orizon-input" asp-for="WhatsApp" inputmode="tel" placeholder="(00) 00000-0000" />
                <span class="orizon-field__error" asp-validation-for="WhatsApp"></span>
            </div>

            <div class="orizon-field">
                <label class="orizon-field__label" asp-for="Email">Email</label>
                <input class="orizon-input" asp-for="Email" autocomplete="email" placeholder="email@exemplo.com" />
                <span class="orizon-field__error" asp-validation-for="Email"></span>
            </div>
        </div>
    </section>

    <section class="admin-form-section">
        <div class="admin-form-section-title">
            <div>
                <span class="rn-eyebrow">Endereço</span>
                <h2>Localização</h2>
                <p>Endereço completo para cadastro institucional.</p>
            </div>
        </div>

        <div class="orizon-field">
            <label class="orizon-field__label" asp-for="Address">Endereço completo</label>
            <input class="orizon-input" asp-for="Address" autocomplete="street-address" placeholder="Rua, número, bairro, cidade e UF" />
            <span class="orizon-field__error" asp-validation-for="Address"></span>
        </div>
    </section>

    <section class="admin-form-section">
        <div class="admin-form-section-title">
            <div>
                <span class="rn-eyebrow">Acolhimento</span>
                <h2>Informações do acompanhamento</h2>
                <p>Dados operacionais para início e histórico do tratamento.</p>
            </div>
        </div>

        <div class="orizon-form-grid">
            <div class="orizon-field">
                <label class="orizon-field__label required" asp-for="AdmissionDate">Data de entrada</label>
                <input class="orizon-input" asp-for="AdmissionDate" type="date" />
                <span class="orizon-field__error" asp-validation-for="AdmissionDate"></span>
            </div>
        </div>

        <div class="orizon-field mt-3">
            <label class="orizon-field__label" asp-for="Notes">Observações</label>
            <textarea class="orizon-textarea" asp-for="Notes" placeholder="Registre observações relevantes para a equipe"></textarea>
            <span class="orizon-field__message">Campo visual para apoio à demonstração. Não altera o modelo de domínio atual.</span>
            <span class="orizon-field__error" asp-validation-for="Notes"></span>
        </div>
    </section>

    <div class="orizon-form-actions">
        <a class="orizon-button orizon-button--outline orizon-button--neutral orizon-button--md" asp-action="Index">
            Cancelar
        </a>

        <button class="orizon-button orizon-button--solid orizon-button--primary orizon-button--md" type="submit">
            
            @(isEdit ? "Salvar alterações" : "Cadastrar acolhido")
        </button>
    </div>
</div>

