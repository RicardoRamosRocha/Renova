@using Renova.Domain.Entities
@using Renova.Web.Areas.CRM.Controllers
@using Renova.Web.Areas.CRM.ViewModels.Appointments
@model AppointmentDetailsViewModel
@{ ViewData["Title"] = "Detalhes do atendimento"; var statusClass = Model.Status == AppointmentStatus.Cancelled ? "danger" : Model.Status == AppointmentStatus.Completed ? "success" : "info"; }
<section class="admin-page"><header class="admin-form-header"><div><nav class="admin-form-breadcrumb"><a asp-action="Index">Agenda</a><span>/</span><span>Detalhes</span></nav><span class="rn-eyebrow">CRM / Agenda</span><h1>Atendimento de @Model.StudentName</h1><p><span class="renova-status-badge @statusClass">@AppointmentsController.StatusLabel((int)Model.Status)</span></p></div><div class="crm-page-header__actions"><a class="orizon-button orizon-button--outline orizon-button--neutral orizon-button--md" asp-action="Index">Agenda</a><a class="orizon-button orizon-button--solid orizon-button--primary orizon-button--md" asp-action="Edit" asp-route-id="@Model.Id">Editar</a></div></header>
<div class="patient-profile-grid"><section class="patient-card"><div class="patient-card-title"><span>01</span><div><h2>Agendamento</h2><p>Vínculos e horário do atendimento.</p></div></div><dl class="patient-data-list"><div><dt>Acolhido</dt><dd><a asp-area="CRM" asp-controller="Students" asp-action="Details" asp-route-id="@Model.StudentId">@Model.StudentName</a></dd></div><div><dt>Profissional</dt><dd>@(Model.ProfessionalName ?? "Não definido")</dd></div><div><dt>Data</dt><dd>@Model.ScheduledAt.ToString("dd/MM/yyyy HH:mm")</dd></div><div><dt>Criado em</dt><dd>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd></div></dl></section><section class="patient-card"><div class="patient-card-title"><span>02</span><div><h2>Observações</h2><p>Registro operacional do atendimento.</p></div></div><p>@(Model.Notes ?? "Nenhuma observação registrada.")</p></section></div>
@if (Model.Status != AppointmentStatus.Cancelled) { <div class="orizon-form-actions"><form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Cancelar este atendimento?');"><button class="orizon-button orizon-button--outline orizon-button--danger orizon-button--md" type="submit">Cancelar atendimento</button></form></div> }</section>
