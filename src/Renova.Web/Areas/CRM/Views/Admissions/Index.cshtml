@using Renova.Domain.Entities
@model IReadOnlyList<Admission>
@{
    ViewData["Title"] = "Admissões";
}

<section class="admin-page">
    <header class="admin-page-header">
        <div>
            <span class="rn-eyebrow">CRM</span>
            <h1>Admissões de @ViewBag.StudentName</h1>
        </div>
        <div>
            <a class="orizon-button orizon-button--solid orizon-button--primary orizon-button--md" asp-action="Create" asp-route-studentId="@ViewBag.StudentId">Nova admissão</a>
        </div>
    </header>

    <section class="orizon-card orizon-card--padding-none">
        @if (Model.Count == 0)
        {
            <section class="admin-empty-state">
                <div class="crm-empty-icon"></div>
                <strong>Nenhuma admissão registrada</strong>
                <p>Crie a primeira admissão para iniciar o histórico do acolhido.</p>
            </section>
        }
        else
        {
            <div class="orizon-table-container">
                <table class="orizon-table orizon-table--hoverable">
                    <thead><tr><th>Entrada</th><th>Status</th><th>Responsável</th><th>Previsão</th><th class="text-end">Ações</th></tr></thead>
                    <tbody>
                    @foreach (var admission in Model)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@admission.Id">@admission.AdmissionDate.ToString("dd/MM/yyyy")</a></td>
                            <td><span class="orizon-badge orizon-badge--md @((admission.AdmissionStatus == AdmissionStatus.Active) ? "orizon-badge--success" : admission.AdmissionStatus == AdmissionStatus.Planned ? "orizon-badge--warning" : admission.AdmissionStatus == AdmissionStatus.Cancelled ? "orizon-badge--danger" : "orizon-badge--info")">@AdmissionStatusLabel(admission.AdmissionStatus)</span></td>
                            <td>@(admission.ResponsibleProfessional ?? "Não informado")</td>
                            <td>@(admission.ExpectedDischargeDate?.ToString("dd/MM/yyyy") ?? "Sem previsão")</td>
                            <td>
                                <div class="rn-premium-actions">
                                    <a class="orizon-button orizon-button--ghost orizon-button--neutral orizon-button--sm" asp-action="Details" asp-route-id="@admission.Id" title="Ver detalhes">Ver</a>
                                    <a class="orizon-button orizon-button--ghost orizon-button--neutral orizon-button--sm" asp-action="Edit" asp-route-id="@admission.Id" title="Editar">Editar</a>
                                    @if (admission.AdmissionStatus is AdmissionStatus.Active or AdmissionStatus.Planned)
                                    {
                                        <form asp-action="Discharge" asp-route-id="@admission.Id" method="post" onsubmit="return confirm('Registrar alta desta admissão?');"><button class="orizon-button orizon-button--ghost orizon-button--neutral orizon-button--sm" type="submit" title="Alta">Alta</button></form>
                                        <form asp-action="Transfer" asp-route-id="@admission.Id" method="post" onsubmit="return confirm('Registrar transferência desta admissão?');"><button class="orizon-button orizon-button--ghost orizon-button--neutral orizon-button--sm" type="submit" title="Transferir">Transferir</button></form>
                                        <form asp-action="Cancel" asp-route-id="@admission.Id" method="post" onsubmit="return confirm('Cancelar esta admissão?');"><button class="orizon-button orizon-button--ghost orizon-button--neutral orizon-button--sm" type="submit" title="Cancelar">Cancelar</button></form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</section>

@functions {
    private static string AdmissionStatusLabel(AdmissionStatus status) => status switch
    {
        AdmissionStatus.Active => "Ativa",
        AdmissionStatus.Planned => "Planejada",
        AdmissionStatus.Discharged => "Alta",
        AdmissionStatus.Cancelled => "Cancelada",
        AdmissionStatus.Transferred => "Transferida",
        _ => "Admissão"
    };
}

