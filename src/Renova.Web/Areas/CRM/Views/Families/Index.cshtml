@using Renova.Web.Areas.CRM.ViewModels.Families
@using Renova.Web.ViewModels
@model FamilyIndexViewModel
@{
    ViewData["Title"] = "Famílias";
    var paged = Model.Families;
}

<section class="admin-page renova-listing-page">
    <header class="admin-form-header renova-listing-header">
        <div class="renova-listing-header__content">
            <span class="rn-eyebrow">CRM / Famílias</span>
            <h1>Vínculos familiares</h1>
            <p>Contatos familiares vinculados aos acolhidos do tenant atual.</p>
        </div>
    </header>

    <section class="orizon-card renova-listing-toolbar">
        <div class="renova-listing-toolbar__heading">
            <h2>Buscar familiares</h2>
            <p>Use os filtros para localizar vínculos familiares no tenant atual.</p>
        </div>
        <form method="get" class="renova-listing-filters">
            <div class="orizon-field">
                <label class="orizon-field__label" for="search">Buscar</label>
                <input class="orizon-input" id="search" name="search" value="@Model.Search" placeholder="Nome, acolhido, parentesco ou telefone" />
            </div>
            <div class="orizon-field">
                <label class="orizon-field__label" for="include-archived">Status do vínculo</label>
                <label for="include-archived"><input id="include-archived" type="checkbox" name="includeArchived" value="true" checked="@Model.IncludeArchived" /> <span>Incluir arquivados</span></label>
            </div>
            @if (Model.StudentId.HasValue) { <input type="hidden" name="studentId" value="@Model.StudentId" /> }
            <div class="orizon-form-actions"><button class="orizon-button orizon-button--solid orizon-button--primary orizon-button--md" type="submit">Buscar</button><a class="orizon-button orizon-button--outline orizon-button--neutral orizon-button--md" asp-action="Index">Limpar</a></div>
        </form>
    </section>

    @if (TempData["Success"] is string success)
    {
        <div class="crm-alert-success">
            
            <span>@success</span>
        </div>
    }

    <section class="orizon-card orizon-card--padding-none renova-listing-card renova-listing-card--flush">
        @if (paged.Items.Count == 0)
        {
            <div class="renova-listing-empty">
                <div class="renova-listing-empty__icon"><orizon-icon name="users" size="28" /></div>
                <strong>Nenhum familiar encontrado</strong>
                <p>Cadastre familiares a partir do perfil de um acolhido.</p>
                <a class="orizon-button orizon-button--outline orizon-button--neutral orizon-button--md" asp-controller="Students" asp-action="Index">
                    
                    Ver acolhidos
                </a>
            </div>
        }
        else
        {
            <div class="orizon-table-container renova-listing-table-wrap">
                <table class="orizon-table orizon-table--hoverable renova-listing-table">
                    <thead>
                        <tr>
                            <th>Familiar</th>
                            <th>Acolhido</th>
                            <th>Parentesco</th>
                            <th>Contato</th>
                            <th>Permissões</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var member in paged.Items)
                    {
                        <tr>
                            <td>
                                <span class="renova-person-cell">
                                    @await Html.PartialAsync("~/Views/Shared/_ProfileAvatar.cshtml", new ProfileAvatarViewModel
                                    {
                                        Name = member.Name,
                                        PhotoUrl = member.PhotoUrl
                                    })
                                    <span>
                                        <strong class="renova-row-title">@member.Name</strong>
                                        <small class="renova-row-subtitle">@(member.Email ?? "Sem email")</small>
                                    </span>
                                </span>
                            </td>
                            <td><a asp-controller="Students" asp-action="Details" asp-route-id="@member.StudentId">@member.StudentName</a></td>
                            <td>@member.Relationship</td>
                            <td>@member.Phone</td>
                            <td>
                                @if (member.IsResponsible)
                                {
                                    <span class="orizon-badge orizon-badge--info orizon-badge--md">Responsável</span>
                                }
                                @if (member.CanAccessPortal)
                                {
                                    <span class="orizon-badge orizon-badge--success orizon-badge--md">Portal</span>
                                }
                            </td>
                            <td>
                                <div class="renova-action-buttons renova-row-actions">
                                    <a class="orizon-button orizon-button--ghost orizon-button--neutral orizon-button--sm" asp-action="Details" asp-route-id="@member.Id" title="Detalhes">Ver</a>
                                    @if (!member.IsArchived)
                                    {
                                    <a class="orizon-button orizon-button--ghost orizon-button--neutral orizon-button--sm" asp-action="Edit" asp-route-id="@member.Id" title="Editar">
                                        Editar
                                    </a>
                                    <form asp-action="Archive" asp-route-id="@member.Id" method="post" onsubmit="return confirm('Arquivar este vínculo familiar?');">
                                        <button class="orizon-button orizon-button--ghost orizon-button--danger orizon-button--sm" type="submit" title="Arquivar">Arquivar</button>
                                    </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        <div class="renova-listing-pagination">
            @await Html.PartialAsync("~/Views/Shared/_Pagination.cshtml", paged)
        </div>
    </section>
</section>

