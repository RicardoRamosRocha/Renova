@using Renova.Domain.Entities
@using Renova.Web.Areas.CRM.ViewModels.Families
@using Renova.Web.ViewModels
@model FamilyMemberFormViewModel

<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="StudentId" />
<input type="hidden" asp-for="StudentName" />
<input type="hidden" asp-for="PhotoPath" />

<div asp-validation-summary="ModelOnly" class="orizon-alert orizon-alert--danger"></div>

@await Html.PartialAsync("~/Views/Shared/_ProfileHeader.cshtml", new ProfileHeaderViewModel
{
    Name = Model.FullName,
    Subtitle = $"Familiar de {Model.StudentName}",
    Status = Model.IsResponsible ? "Responsável principal" : "Rede de apoio",
    SupportingText = Model.CanAccessPortal ? "Acesso ao portal familiar" : "Sem acesso ao portal",
    PhotoUrl = Model.PhotoPath
})

<div class="admin-form-card">
    <section class="admin-form-section">
        <div class="admin-form-section-title">
            <div>
                <span class="rn-eyebrow">Família</span>
                <h2>Vínculo familiar</h2>
                <p>Cadastre contatos autorizados e responsáveis pela rede de apoio.</p>
            </div>
        </div>

        <div class="orizon-form-grid">
            <div class="orizon-field">
                <label class="orizon-field__label required" asp-for="FullName">Nome completo</label>
                <input class="orizon-input" asp-for="FullName" />
                <span class="orizon-field__error" asp-validation-for="FullName"></span>
            </div>
            <div class="orizon-field">
                <label class="orizon-field__label required" asp-for="Relationship">Parentesco</label>
                <input class="orizon-input" asp-for="Relationship" placeholder="Mãe, pai, cônjuge..." />
                <span class="orizon-field__error" asp-validation-for="Relationship"></span>
            </div>
            <div class="orizon-field">
                <label class="orizon-field__label" asp-for="RelationshipType">Tipo</label>
                <select class="orizon-select" asp-for="RelationshipType" asp-items="Html.GetEnumSelectList<RelationshipType>()">
                    <option value="">Não classificado</option>
                </select>
                <span class="orizon-field__error" asp-validation-for="RelationshipType"></span>
            </div>
            <div class="orizon-field">
                <label class="orizon-field__label required" asp-for="Phone">Telefone</label>
                <input class="orizon-input" asp-for="Phone" inputmode="tel" />
                <span class="orizon-field__error" asp-validation-for="Phone"></span>
            </div>
            <div class="orizon-field">
                <label class="orizon-field__label" asp-for="Email">Email</label>
                <input class="orizon-input" asp-for="Email" />
                <span class="orizon-field__error" asp-validation-for="Email"></span>
            </div>
        </div>

        <div class="orizon-form-grid two mt-3">
            <label class="admin-check">
                <input asp-for="IsResponsible" />
                <span>Responsável principal</span>
            </label>
            <label class="admin-check">
                <input asp-for="CanAccessPortal" />
                <span>Pode acessar portal familiar</span>
            </label>
        </div>
    </section>

    <div class="orizon-form-actions">
        <a class="orizon-button orizon-button--outline orizon-button--neutral orizon-button--md" asp-controller="Students" asp-action="Details" asp-route-id="@Model.StudentId">Cancelar</a>
        <button class="orizon-button orizon-button--solid orizon-button--primary orizon-button--md" type="submit">Salvar familiar</button>
    </div>
</div>

