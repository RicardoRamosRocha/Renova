@using Renova.Web.ViewModels

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<section class="dashboard-v2">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <header class="dashboard-header">

        <div class="dashboard-header-left">

            <span class="dashboard-label">
                RENOVA PLATFORM
            </span>

            <h1>
                Dashboard Executivo
            </h1>

            <p>

                Gestão integrada da Comunidade Terapêutica

            </p>

        </div>

        <div class="dashboard-header-right">

            <a asp-area="CRM"
               asp-controller="Students"
               asp-action="Create"
               class="orizon-button orizon-button--primary">

                Novo acolhido

            </a>

            <a asp-area="CRM"
               asp-controller="Appointments"
               asp-action="Create"
               class="orizon-button orizon-button--secondary">

                Nova consulta

            </a>

        </div>

    </header>

    <!-- ========================================================= -->
    <!-- KPIs -->
    <!-- ========================================================= -->

    <section class="dashboard-kpis">

        <article class="dashboard-kpi">

            <small>Acolhidos</small>

            <h2>126</h2>

            <span class="positive">

                +8%

            </span>

        </article>

        <article class="dashboard-kpi">

            <small>Atendimentos</small>

            <h2>32</h2>

            <span class="positive">

                +18%

            </span>

        </article>

        <article class="dashboard-kpi">

            <small>Taxa de Ocupação</small>

            <h2>91%</h2>

            <span class="positive">

                +2%

            </span>

        </article>

        <article class="dashboard-kpi">

            <small>Receita</small>

            <h2>R$ 98 mil</h2>

            <span class="positive">

                +12%

            </span>

        </article>

    </section>

    <!-- ========================================================= -->
    <!-- GRID -->
    <!-- ========================================================= -->

    <section class="dashboard-main">

        <!-- ===================== LEFT ===================== -->

        <div class="dashboard-left">

            <!-- PERFORMANCE -->

            <section class="dashboard-card">

                <div class="dashboard-card-header">

                    <div>

                        <span class="dashboard-section">

                            PERFORMANCE

                        </span>

                        <h2>

                            Evolução dos últimos 30 dias

                        </h2>

                    </div>

                    <button class="orizon-button orizon-button--outline">

                        Exportar

                    </button>

                </div>

                <div class="chart-placeholder">

                    <div class="bar h40"></div>
                    <div class="bar h55"></div>
                    <div class="bar h48"></div>
                    <div class="bar h70"></div>
                    <div class="bar h62"></div>
                    <div class="bar h85"></div>
                    <div class="bar h100"></div>

                </div>

            </section>

            <!-- GRID -->

            <section class="dashboard-card">

                <div class="dashboard-card-header">

                    <div>

                        <span class="dashboard-section">

                            CRM

                        </span>

                        <h2>

                            Pacientes recentes

                        </h2>

                    </div>

                </div>

                <div class="dashboard-toolbar">

                    <input
                        class="orizon-input"
                        placeholder="Pesquisar..." />

                    <select class="orizon-select">

                        <option>Todos</option>
                        <option>Internados</option>
                        <option>Alta</option>

                    </select>

                    <button class="orizon-button orizon-button--outline">

                        Filtrar

                    </button>

                </div>

                <table class="dashboard-table">

                    <thead>

                        <tr>

                            <th>Paciente</th>
                            <th>Status</th>
                            <th>Entrada</th>
                            <th>Responsável</th>

                        </tr>

                    </thead>

                    <tbody>

                        <tr>

                            <td>João Silva</td>
                            <td>
                                <span class="badge-success">
                                    Internado
                                </span>
                            </td>
                            <td>12/07</td>
                            <td>Dra. Ana</td>

                        </tr>

                        <tr>

                            <td>Maria Souza</td>
                            <td>

                                <span class="badge-warning">

                                    Observação

                                </span>

                            </td>

                            <td>09/07</td>

                            <td>

                                Dr. Carlos

                            </td>

                        </tr>

                        <tr>

                            <td>

                                Pedro Alves

                            </td>

                            <td>

                                <span class="badge-success">

                                    Internado

                                </span>

                            </td>

                            <td>

                                04/07

                            </td>

                            <td>

                                Dra. Paula

                            </td>

                        </tr>

                    </tbody>

                </table>

            </section>

        </div>

        <!-- ===================== RIGHT ===================== -->

        <aside class="dashboard-right">

                <!-- ========================================================= -->
    <!-- AGENDA -->
    <!-- ========================================================= -->

    <section class="dashboard-card">

        <div class="dashboard-card-header">

            <div>

                <span class="dashboard-section">
                    AGENDA
                </span>

                <h2>
                    Hoje
                </h2>

            </div>

            <span class="dashboard-counter">

                6

            </span>

        </div>

        <div class="timeline">

            <article class="timeline-item">

                <span class="timeline-hour">
                    09:00
                </span>

                <div>

                    <strong>

                        Consulta Inicial

                    </strong>

                    <small>

                        João Silva

                    </small>

                </div>

            </article>

            <article class="timeline-item">

                <span class="timeline-hour">

                    10:30

                </span>

                <div>

                    <strong>

                        Atendimento Familiar

                    </strong>

                    <small>

                        Sala 03

                    </small>

                </div>

            </article>

            <article class="timeline-item">

                <span class="timeline-hour">

                    14:00

                </span>

                <div>

                    <strong>

                        Psicologia

                    </strong>

                    <small>

                        Maria Oliveira

                    </small>

                </div>

            </article>

            <article class="timeline-item">

                <span class="timeline-hour">

                    16:30

                </span>

                <div>

                    <strong>

                        Reunião Clínica

                    </strong>

                    <small>

                        Equipe Multidisciplinar

                    </small>

                </div>

            </article>

        </div>

    </section>

    <!-- ========================================================= -->
    <!-- ATIVIDADE -->
    <!-- ========================================================= -->

    <section class="dashboard-card">

        <div class="dashboard-card-header">

            <div>

                <span class="dashboard-section">

                    FEED

                </span>

                <h2>

                    Atividade recente

                </h2>

            </div>

        </div>

        <div class="activity-feed">

            <article>

                <strong>

                    João Silva

                </strong>

                iniciou tratamento.

                <small>

                    há 12 min

                </small>

            </article>

            <article>

                <strong>

                    Novo Curso

                </strong>

                Dependência Química.

                <small>

                    há 28 min

                </small>

            </article>

            <article>

                <strong>

                    Alta registrada

                </strong>

                Carlos Souza.

                <small>

                    10:45

                </small>

            </article>

            <article>

                <strong>

                    Novo profissional

                </strong>

                Psicóloga Ana Paula.

                <small>

                    09:20

                </small>

            </article>

        </div>

    </section>

    <!-- ========================================================= -->
    <!-- IA -->
    <!-- ========================================================= -->

    <section class="dashboard-card dashboard-ai">

        <div class="dashboard-card-header">

            <div>

                <span class="dashboard-section">

                    IA ASSISTENTE

                </span>

                <h2>

                    Insights

                </h2>

            </div>

        </div>

        <div class="ai-list">

            <article class="ai-item warning">

                <strong>

                    3 pacientes

                </strong>

                apresentam risco de evasão.

            </article>

            <article class="ai-item success">

                <strong>

                    8 acolhidos

                </strong>

                concluíram um curso hoje.

            </article>

            <article class="ai-item info">

                <strong>

                    Financeiro

                </strong>

                quatro mensalidades vencem amanhã.

            </article>

            <article class="ai-item danger">

                <strong>

                    Atenção

                </strong>

                existem duas consultas sem confirmação.

            </article>

        </div>

    </section>

    <!-- ========================================================= -->
    <!-- AÇÕES -->
    <!-- ========================================================= -->

    <section class="dashboard-card">

        <div class="dashboard-card-header">

            <h2>

                Ações rápidas

            </h2>

        </div>

        <div class="quick-actions">

            <a asp-area="CRM"
               asp-controller="Students"
               asp-action="Create"
               class="orizon-button orizon-button--primary">

                Novo acolhido

            </a>

            <a asp-area="CRM"
               asp-controller="Appointments"
               asp-action="Create"
               class="orizon-button orizon-button--secondary">

                Nova consulta

            </a>

            <a asp-area="Medical"
               asp-controller="Professionals"
               asp-action="Index"
               class="orizon-button orizon-button--outline">

                Profissionais

            </a>

            <a asp-area="EAD"
               asp-controller="Courses"
               asp-action="Index"
               class="orizon-button orizon-button--outline">

                Cursos

            </a>

        </div>

    </section>

</aside>

</section>