@using Renova.Web.Areas.Admin.ViewModels.Users
@using Renova.Web.ViewModels
@model UserFormViewModel
@{
    var roles = (IReadOnlyList<string>)(ViewBag.Roles ?? new List<string>());
}

<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="PhotoPath" />
<div asp-validation-summary="ModelOnly" class="orizon-alert orizon-alert--danger"></div>

@await Html.PartialAsync("~/Views/Shared/_ProfileHeader.cshtml", new ProfileHeaderViewModel
{
    Name = Model.FullName,
    Subtitle = "Usuário",
    Status = Model.IsActive ? "Ativo" : "Inativo",
    SupportingText = string.IsNullOrWhiteSpace(Model.Role) ? "Sem perfil definido" : Model.Role,
    PhotoUrl = Model.PhotoPath
})

<div class="admin-form-card">
    <section class="admin-form-section">
        <div class="admin-form-section-title">
            <div><span class="rn-eyebrow">Identificação</span><h2>Dados do usuário</h2><p>Informações básicas da conta utilizada para acessar o Renova.</p></div>
        </div>
        <div class="orizon-form-grid">
            <div class="orizon-field"><label class="orizon-field__label required" asp-for="FullName">Nome completo</label><input class="orizon-input" asp-for="FullName" autocomplete="name" /><span class="orizon-field__error" asp-validation-for="FullName"></span></div>
            <div class="orizon-field"><label class="orizon-field__label required" asp-for="Email">Email</label><input class="orizon-input" asp-for="Email" autocomplete="email" /><span class="orizon-field__error" asp-validation-for="Email"></span></div>
            <div class="orizon-field"><label class="orizon-field__label" asp-for="Phone">Telefone</label><input class="orizon-input" asp-for="Phone" inputmode="tel" autocomplete="tel" /><span class="orizon-field__error" asp-validation-for="Phone"></span></div>
            <div class="orizon-field"><label class="orizon-field__label" asp-for="IsActive">Status</label><select class="orizon-select" asp-for="IsActive"><option value="true">Ativo</option><option value="false">Inativo</option></select><span class="orizon-field__error" asp-validation-for="IsActive"></span></div>
        </div>
    </section>

    <section class="admin-form-section">
        <div class="admin-form-section-title">
            <div><span class="rn-eyebrow">Acesso</span><h2>Perfil e senha</h2><p>Defina o perfil de acesso e, se necessário, uma senha provisória.</p></div>
        </div>
        <div class="orizon-form-grid">
            <div class="orizon-field">
                <label class="orizon-field__label" asp-for="Role">Perfil/Role</label>
                <select class="orizon-select" asp-for="Role">
                    <option value="">Sem perfil</option>
                    @foreach (var role in roles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
                <span class="orizon-field__error" asp-validation-for="Role"></span>
            </div>
            <div class="orizon-field">
                <label class="orizon-field__label" asp-for="TemporaryPassword">Senha provisória</label>
                <input class="orizon-input" asp-for="TemporaryPassword" placeholder="Opcional ao editar" />
                <span class="orizon-field__message">Use apenas quando desejar criar ou redefinir uma senha provisória.</span>
                <span class="orizon-field__error" asp-validation-for="TemporaryPassword"></span>
            </div>
        </div>
    </section>

    <div class="orizon-form-actions">
        <a class="orizon-button orizon-button--outline orizon-button--neutral orizon-button--md" asp-action="Index">Cancelar</a>
        <button class="orizon-button orizon-button--solid orizon-button--primary orizon-button--md" type="submit">Salvar usuário</button>
    </div>
</div>

