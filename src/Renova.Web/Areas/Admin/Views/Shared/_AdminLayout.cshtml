<!DOCTYPE html>
<html lang="pt-BR" data-theme="light" data-color-mode="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | Renova</title>
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <link rel="stylesheet" href="~/_content/Orizon.UI/css/orizon.css" asp-append-version="true" />
    <link rel="stylesheet"
      href="~/css/dashboard-v2.css"
      asp-append-version="true" />
      <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="orizon-admin-body">
    <a class="orizon-sr-only orizon-focusable" href="#main-content">Pular para o conteúdo</a>
    <div class="orizon-admin-shell" data-admin-layout>
        <div class="orizon-sidebar-backdrop" data-sidebar-backdrop aria-hidden="true"></div>
        <aside class="orizon-admin-sidebar" data-sidebar aria-label="Navegação principal">
            @await Html.PartialAsync("~/Areas/Admin/Views/Shared/_AdminSidebar.cshtml")
        </aside>

        <div class="orizon-admin-main">
            @await Html.PartialAsync("~/Areas/Admin/Views/Shared/_AdminTopbar.cshtml")

            <main id="main-content" class="orizon-admin-content" tabindex="-1">
                @await Html.PartialAsync("~/Areas/Admin/Views/Shared/_AdminBreadcrumb.cshtml")
                <div class="orizon-admin-page">
                    <div class="orizon-admin-messages" role="region" aria-label="Mensagens do sistema" aria-live="polite">
                        @if (TempData["Success"] is string successMessage)
                        {
                            <orizon-alert variant="success" title="Operação concluída" dismissible>@successMessage</orizon-alert>
                        }
                        @if (TempData["Error"] is string errorMessage)
                        {
                            <orizon-alert variant="danger" title="Não foi possível concluir" dismissible>@errorMessage</orizon-alert>
                        }
                        @if (TempData["Warning"] is string warningMessage)
                        {
                            <orizon-alert variant="warning" title="Atenção" dismissible>@warningMessage</orizon-alert>
                        }
                        @if (TempData["Info"] is string infoMessage)
                        {
                            <orizon-alert variant="info" title="Informação" dismissible>@infoMessage</orizon-alert>
                        }
                        @if (ViewData["Message"] is string viewMessage)
                        {
                            <orizon-alert variant="info">@viewMessage</orizon-alert>
                        }
                        <div asp-validation-summary="All" class="orizon-validation-summary"></div>
                        @await RenderSectionAsync("Notifications", required: false)
                    </div>
                    @RenderBody()
                </div>
            </main>

            <div class="orizon-admin-footer">
                <footer class="orizon-footer">
                    <div class="orizon-footer-left">© @DateTime.Now.Year <strong>Renova</strong></div>
                    <div class="orizon-footer-right"><span>Orizon.UI 1.0.0-rc.1</span></div>
                </footer>
            </div>
        </div>
    </div>
    <script src="~/_content/Orizon.UI/js/layout/admin-layout.js" asp-append-version="true"></script>
    <script src="~/_content/Orizon.UI/js/layout/sidebar.js" asp-append-version="true"></script>
    <script type="module" src="~/_content/Orizon.UI/js/orizon.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
