@using Renova.Domain.Entities
@using Renova.Web.ViewModels
@model PagedResult<Professional>
@{
    ViewData["Title"] = "Profissionais";
}

<section class="admin-page renova-listing-page">
    <header class="admin-page-header renova-listing-header">
        <div class="renova-listing-header__content">
            <span>Medical / Profissionais</span>
            <h1>Profissionais</h1>
            <p>Gerencie equipe técnica, especialidades e status de atendimento.</p>
        </div>
        <div class="renova-listing-header__actions">
            <a class="orizon-button orizon-button--solid orizon-button--primary orizon-button--md" asp-action="Create">Novo profissional</a>
        </div>
    </header>

    @if (TempData["Success"] is string success)
    {
        <div class="orizon-alert orizon-alert--success">@success</div>
    }

    <div class="renova-listing-metrics">
        <article class="orizon-card orizon-card--elevated orizon-card--padding-md"><span>Profissionais</span><strong>@ViewBag.Total</strong><small>Total</small></article>
        <article class="orizon-card orizon-card--elevated orizon-card--padding-md"><span>Ativos</span><strong>@ViewBag.ActiveCount</strong><small>Disponíveis</small></article>
        <article class="orizon-card orizon-card--elevated orizon-card--padding-md"><span>Inativos</span><strong>@ViewBag.InactiveCount</strong><small>Arquivados</small></article>
        <article class="orizon-card orizon-card--elevated orizon-card--padding-md"><span>Especialidades</span><strong>@ViewBag.Specialties</strong><small>Áreas técnicas</small></article>
    </div>

    <div class="renova-listing-toolbar">
            <div class="renova-listing-toolbar__heading">
                <span class="rn-eyebrow">Busca e filtros</span>
                <h2>Lista de profissionais</h2>
                <p>Visualize especialidade, registro, status e ações principais.</p>
            </div>
            <form class="renova-listing-filters" method="get">
                <div class="orizon-field">
                    <label class="orizon-field__label" for="professional-search">Buscar profissional</label>
                    <input id="professional-search" class="orizon-input" name="search" value="@ViewBag.Search" type="search" placeholder="Pesquisar por nome, email, especialidade ou registro" />
                </div>
                <div class="orizon-field">
                    <label class="orizon-field__label" for="professional-active">Status</label>
                    <select id="professional-active" class="orizon-select" name="active">
                    <option value="">Todos os status</option>
                    <option value="true" selected="@(ViewBag.Active == true)">Ativo</option>
                    <option value="false" selected="@(ViewBag.Active == false)">Inativo</option>
                    </select>
                </div>
                <div class="renova-filter-submit"><button class="orizon-button orizon-button--outline orizon-button--neutral orizon-button--md" type="submit">Filtrar</button></div>
            </form>
    </div>

    <section class="orizon-card orizon-card--padding-none renova-listing-card renova-listing-card--flush">
        @if (Model.Items.Count == 0)
        {
            <div class="renova-listing-empty">
                <div class="renova-listing-empty__icon"><orizon-icon name="user-check" size="28" /></div>
                <strong>Nenhum registro encontrado</strong>
                <p>Cadastre a equipe técnica para iniciar a operação.</p>
                <a class="orizon-button orizon-button--solid orizon-button--primary orizon-button--md" asp-action="Create">Criar primeiro cadastro</a>
            </div>
        }
        else
        {
            <div class="orizon-table-container renova-listing-table-wrap">
                <table class="orizon-table orizon-table--hoverable renova-listing-table">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Especialidade</th>
                            <th>Registro</th>
                            <th>Telefone</th>
                            <th>Situação</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var professional in Model.Items)
                    {
                        var displayName = professional.DisplayName;
                        <tr>
                            <td>
                                <div class="renova-person-cell">
                                    @await Html.PartialAsync("~/Views/Shared/_ProfileAvatar.cshtml", new ProfileAvatarViewModel
                                    {
                                        Name = displayName,
                                        PhotoUrl = professional.DisplayPhotoUrl
                                    })
                                    <span>
                                        <strong class="renova-row-title">@displayName</strong>
                                        <small class="renova-row-subtitle">Equipe técnica</small>
                                    </span>
                                </div>
                            </td>
                            <td><span class="renova-muted">@professional.Specialty</span></td>
                            <td><span class="renova-muted">@professional.RegistrationNumber</span></td>
                            <td><span class="renova-muted">@professional.DisplayPhone</span></td>
                            <td><span class="orizon-badge orizon-badge--md @(professional.IsActive ? "orizon-badge--success" : "orizon-badge--danger")">@(professional.IsActive ? "Ativo" : "Inativo")</span></td>
                            <td>
                                <div class="renova-action-buttons renova-row-actions">
                                    <a class="orizon-button orizon-button--ghost orizon-button--neutral orizon-button--sm" title="Detalhes" aria-label="Ver detalhes de @displayName" asp-action="Details" asp-route-id="@professional.Id"><orizon-icon name="eye" size="16" /></a>
                                    <a class="orizon-button orizon-button--ghost orizon-button--neutral orizon-button--sm" title="Editar" aria-label="Editar @displayName" asp-action="Edit" asp-route-id="@professional.Id"><orizon-icon name="edit" size="16" /></a>
                                    <a class="orizon-button orizon-button--ghost orizon-button--danger orizon-button--sm" title="Excluir" aria-label="Excluir @displayName" href="#delete-professional-@professional.Id"><orizon-icon name="archive" size="16" /></a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            @await Html.PartialAsync("~/Views/Shared/_Pagination.cshtml", Model)

            @foreach (var professional in Model.Items)
            {
                <div id="delete-professional-@professional.Id" class="admin-delete-modal" role="dialog" aria-modal="true">
                    <div class="admin-delete-dialog">
                        <h2>Excluir profissional</h2>
                        <p>Deseja realmente excluir este registro? Se houver vínculos, o profissional será inativado com segurança.</p>
                        <div class="admin-delete-actions">
                            <a class="orizon-button orizon-button--outline orizon-button--neutral orizon-button--md" href="#">Cancelar</a>
                            <form asp-action="Delete" asp-route-id="@professional.Id" method="post"><button class="orizon-button orizon-button--solid orizon-button--danger orizon-button--md" type="submit">Excluir</button></form>
                        </div>
                    </div>
                </div>
            }
        }
    </section>
</section>

