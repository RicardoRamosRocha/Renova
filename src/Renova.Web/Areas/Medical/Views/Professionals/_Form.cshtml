@using Renova.Web.Areas.Medical.ViewModels.Professionals
@using Renova.Web.ViewModels
@model ProfessionalFormViewModel
@{
    var specialties = new[] { "Psicólogo", "Terapeuta", "Assistente Social", "Coordenador", "Médico", "Educador", "Administrativo" };
}

<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="PhotoPath" />
<div asp-validation-summary="ModelOnly" class="orizon-alert orizon-alert--danger"></div>

@await Html.PartialAsync("~/Views/Shared/_ProfileHeader.cshtml", new ProfileHeaderViewModel
{
    Name = Model.FullName,
    Subtitle = "Profissional",
    Status = Model.IsActive ? "Ativo" : "Inativo",
    SupportingText = Model.Specialty,
    PhotoUrl = Model.PhotoPath
})

<div class="admin-form-card">
    <section class="admin-form-section">
        <div class="admin-form-section-title">
            <div><span class="rn-eyebrow">Dados pessoais</span><h2>Identificação profissional</h2><p>Dados usados para agenda, prontuário e gestão da equipe.</p></div>
        </div>
        <div class="orizon-form-grid">
            <div class="orizon-field"><label class="orizon-field__label required" asp-for="FullName">Nome completo</label><input class="orizon-input" asp-for="FullName" autocomplete="name" /><span class="orizon-field__error" asp-validation-for="FullName"></span></div>
            <div class="orizon-field"><label class="orizon-field__label" asp-for="CPF">CPF</label><input class="orizon-input" asp-for="CPF" inputmode="numeric" /><span class="orizon-field__error" asp-validation-for="CPF"></span></div>
            <div class="orizon-field"><label class="orizon-field__label required" asp-for="RegistrationNumber">Registro profissional</label><input class="orizon-input" asp-for="RegistrationNumber" /><span class="orizon-field__error" asp-validation-for="RegistrationNumber"></span></div>
            <div class="orizon-field"><label class="orizon-field__label required" asp-for="Specialty">Especialidade</label><select class="orizon-select" asp-for="Specialty">@foreach (var item in specialties) { <option value="@item">@item</option> }</select><span class="orizon-field__error" asp-validation-for="Specialty"></span></div>
            <div class="orizon-field"><label class="orizon-field__label required" asp-for="IsActive">Status</label><select class="orizon-select" asp-for="IsActive"><option value="true">Ativo</option><option value="false">Inativo</option></select><span class="orizon-field__error" asp-validation-for="IsActive"></span></div>
        </div>
    </section>

    <section class="admin-form-section">
        <div class="admin-form-section-title">
            <div><span class="rn-eyebrow">Contato</span><h2>Canais de comunicação</h2><p>Informações para notificações, agenda e contatos da operação.</p></div>
        </div>
        <div class="orizon-form-grid">
            <div class="orizon-field"><label class="orizon-field__label required" asp-for="Phone">Telefone</label><input class="orizon-input" asp-for="Phone" inputmode="tel" autocomplete="tel" /><span class="orizon-field__error" asp-validation-for="Phone"></span></div>
            <div class="orizon-field"><label class="orizon-field__label" asp-for="WhatsApp">WhatsApp</label><input class="orizon-input" asp-for="WhatsApp" inputmode="tel" /><span class="orizon-field__error" asp-validation-for="WhatsApp"></span></div>
            <div class="orizon-field"><label class="orizon-field__label" asp-for="Email">Email</label><input class="orizon-input" asp-for="Email" autocomplete="email" /><span class="orizon-field__error" asp-validation-for="Email"></span></div>
        </div>
    </section>

    <section class="admin-form-section">
        <div class="admin-form-section-title">
            <div><span class="rn-eyebrow">Observações</span><h2>Notas internas</h2><p>Use para informações complementares durante a demonstração.</p></div>
        </div>
        <div class="orizon-field">
            <label class="orizon-field__label" asp-for="Notes">Observações</label>
            <textarea class="orizon-textarea" asp-for="Notes"></textarea>
            <span class="orizon-field__message">Campo visual para apoio à demonstração. Não altera o modelo de domínio atual.</span>
            <span class="orizon-field__error" asp-validation-for="Notes"></span>
        </div>
    </section>

    <div class="orizon-form-actions">
        <a class="orizon-button orizon-button--outline orizon-button--neutral orizon-button--md" asp-action="Index">Cancelar</a>
        <button class="orizon-button orizon-button--solid orizon-button--primary orizon-button--md" type="submit">Salvar profissional</button>
    </div>
</div>

