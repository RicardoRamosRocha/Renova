@using Renova.Web.Areas.EAD.ViewModels.Courses
@model CourseFormViewModel

<input type="hidden" asp-for="Id" />
<div asp-validation-summary="ModelOnly" class="orizon-alert orizon-alert--danger"></div>

<div class="admin-form-card">
    <section class="admin-form-section">
        <div class="admin-form-section-title">
            <div><span class="rn-eyebrow">Informações do curso</span><h2>Conteúdo e categorização</h2><p>Dados principais para organizar a biblioteca EAD.</p></div>
        </div>
        <div class="orizon-form-grid">
            <div class="orizon-field"><label class="orizon-field__label required" asp-for="Title">Título</label><input class="orizon-input" asp-for="Title" /><span class="orizon-field__error" asp-validation-for="Title"></span></div>
            <div class="orizon-field"><label class="orizon-field__label" asp-for="Category">Categoria</label><input class="orizon-input" asp-for="Category" placeholder="Ex.: Reintegração" /><span class="orizon-field__error" asp-validation-for="Category"></span></div>
            <div class="orizon-field"><label class="orizon-field__label" asp-for="Teacher">Professor/responsável</label><input class="orizon-input" asp-for="Teacher" placeholder="Ex.: Dra. Camila Torres" /><span class="orizon-field__error" asp-validation-for="Teacher"></span></div>
            <div class="orizon-field"><label class="orizon-field__label" asp-for="WorkloadHours">Carga horária</label><input class="orizon-input" asp-for="WorkloadHours" type="number" min="1" /><span class="orizon-field__error" asp-validation-for="WorkloadHours"></span></div>
            <div class="orizon-field"><label class="orizon-field__label" asp-for="Status">Status</label><select class="orizon-select" asp-for="Status"><option>Rascunho</option><option>Publicado</option><option>Arquivado</option></select><span class="orizon-field__error" asp-validation-for="Status"></span></div>
        </div>
        <div class="orizon-alert orizon-alert--info" style="margin-top: 16px;">
            
            Categoria, professor e carga horaria estao preparados na UX; a persistencia definitiva depende de migration futura porque o dominio atual de Course possui apenas titulo, descricao e ativo.
        </div>
    </section>

    <section class="admin-form-section">
        <div class="admin-form-section-title">
            <div><span class="rn-eyebrow">Publicação</span><h2>Disponibilidade</h2><p>Controle simples para exibir ou arquivar o curso na biblioteca.</p></div>
        </div>
        <div class="orizon-form-grid">
            <div class="orizon-field">
                <label class="orizon-field__label" asp-for="IsActive">Publicado</label>
                <select class="orizon-select" asp-for="IsActive"><option value="true">Sim</option><option value="false">Não</option></select>
                <span class="orizon-field__error" asp-validation-for="IsActive"></span>
            </div>
            <div class="orizon-field">
                <label class="orizon-field__label">Data de criação</label>
                <input class="orizon-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" type="date" disabled />
                <span class="orizon-field__message">Exibição visual; a data real é controlada pelo sistema.</span>
            </div>
        </div>
    </section>

    <section class="admin-form-section">
        <div class="admin-form-section-title">
            <div><span class="rn-eyebrow">Descrição</span><h2>Resumo do curso</h2><p>Texto de apresentação para ajudar o cliente a visualizar a biblioteca EAD.</p></div>
        </div>
        <div class="orizon-field">
            <label class="orizon-field__label required" asp-for="Description">Descrição</label>
            <textarea class="orizon-textarea" asp-for="Description"></textarea>
            <span class="orizon-field__error" asp-validation-for="Description"></span>
        </div>
    </section>

    <div class="orizon-form-actions">
        <a class="orizon-button orizon-button--outline orizon-button--neutral orizon-button--md" asp-action="Index">Cancelar</a>
        <button class="orizon-button orizon-button--solid orizon-button--primary orizon-button--md" type="submit">Salvar curso</button>
    </div>
</div>

