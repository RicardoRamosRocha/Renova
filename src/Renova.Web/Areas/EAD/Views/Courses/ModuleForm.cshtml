@using Renova.Web.Areas.EAD.ViewModels.Courses
@model CourseModuleFormViewModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Editar Modulo" : "Novo Modulo";
}

<section class="admin-form-page">
    <header class="admin-form-header">
        <div>
            <nav class="admin-form-breadcrumb"><a asp-action="Content" asp-route-id="@Model.CourseId">Conteudo</a><span>/</span><span>@ViewData["Title"]</span></nav>
            <span class="rn-eyebrow">EAD</span>
            <h1>@ViewData["Title"]</h1>
            <p>Defina o bloco pedagogico que agrupa aulas do curso.</p>
        </div>
        <a class="rn-btn-secondary" asp-action="Content" asp-route-id="@Model.CourseId"><i class="ph ph-arrow-left" aria-hidden="true"></i>Voltar</a>
    </header>

    <form asp-action="@(Model.Id.HasValue ? "EditModule" : "CreateModule")" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CourseId" />
        <div class="admin-form-card">
            <section class="admin-form-section">
                <div class="admin-form-section-title"><div><span class="rn-eyebrow">Modulo</span><h2>Identificacao</h2><p>Titulo e descricao aparecem para administradores e alunos.</p></div></div>
                <div class="admin-form-grid">
                    <div class="admin-form-group"><label class="admin-label required" asp-for="Title">Titulo</label><input class="admin-input" asp-for="Title" /><span class="admin-validation" asp-validation-for="Title"></span></div>
                    <div class="admin-form-group"><label class="admin-label required" asp-for="Order">Ordem</label><input class="admin-input" asp-for="Order" type="number" min="1" /><span class="admin-validation" asp-validation-for="Order"></span></div>
                    <div class="admin-form-group-full"><label class="admin-label required" asp-for="Description">Descricao</label><textarea class="admin-textarea" asp-for="Description"></textarea><span class="admin-validation" asp-validation-for="Description"></span></div>
                </div>
            </section>
            <div class="admin-form-actions">
                <a class="rn-btn-secondary" asp-action="Content" asp-route-id="@Model.CourseId">Cancelar</a>
                <button class="rn-btn-primary" type="submit"><i class="ph ph-check-circle" aria-hidden="true"></i>Salvar modulo</button>
            </div>
        </div>
    </form>
</section>
