@using Renova.Web.Areas.EAD.ViewModels.Courses
@model CourseModuleFormViewModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Editar Modulo" : "Novo Modulo";
}

<section class="admin-form-page">
    <header class="admin-form-header">
        <div>
            <nav class="admin-form-breadcrumb"><a asp-action="Content" asp-route-id="@Model.CourseId">Conteudo</a><span>/</span><span>@ViewData["Title"]</span></nav>
            <span class="rn-eyebrow">EAD</span>
            <h1>@ViewData["Title"]</h1>
            <p>Defina o bloco pedagogico que agrupa aulas do curso.</p>
        </div>
        <a class="orizon-button orizon-button--outline orizon-button--neutral orizon-button--md" asp-action="Content" asp-route-id="@Model.CourseId">Voltar</a>
    </header>

    <form asp-action="@(Model.Id.HasValue ? "EditModule" : "CreateModule")" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CourseId" />
        <div class="admin-form-card">
            <section class="admin-form-section">
                <div class="admin-form-section-title"><div><span class="rn-eyebrow">Modulo</span><h2>Identificacao</h2><p>Titulo e descricao aparecem para administradores e alunos.</p></div></div>
                <div class="orizon-form-grid">
                    <div class="orizon-field"><label class="orizon-field__label required" asp-for="Title">Titulo</label><input class="orizon-input" asp-for="Title" /><span class="orizon-field__error" asp-validation-for="Title"></span></div>
                    <div class="orizon-field"><label class="orizon-field__label required" asp-for="Order">Ordem</label><input class="orizon-input" asp-for="Order" type="number" min="1" /><span class="orizon-field__error" asp-validation-for="Order"></span></div>
                    <div class="orizon-field"><label class="orizon-field__label required" asp-for="Description">Descricao</label><textarea class="orizon-textarea" asp-for="Description"></textarea><span class="orizon-field__error" asp-validation-for="Description"></span></div>
                </div>
            </section>
            <div class="orizon-form-actions">
                <a class="orizon-button orizon-button--outline orizon-button--neutral orizon-button--md" asp-action="Content" asp-route-id="@Model.CourseId">Cancelar</a>
                <button class="orizon-button orizon-button--solid orizon-button--primary orizon-button--md" type="submit">Salvar modulo</button>
            </div>
        </div>
    </form>
</section>

