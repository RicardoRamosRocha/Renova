@using Renova.Web.Areas.EAD.ViewModels.Courses
@model CourseIndexViewModel
@{
    ViewData["Title"] = "Cursos";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<section class="orizon-grid orizon-gap-6">
    <div class="orizon-card orizon-card--gradient orizon-card--padding-lg orizon-flex orizon-items-center orizon-justify-between orizon-gap-4">
        <div>
            <span class="orizon-badge orizon-badge--info orizon-badge--sm">Plataforma EAD</span>
            <h1>Biblioteca de Cursos</h1>
            <p>Cursos ligados a trilhas terapêuticas, progresso real dos acolhidos e certificados emitidos.</p>
        </div>

        <a class="orizon-button orizon-button--solid orizon-button--primary orizon-button--md" asp-area="EAD" asp-controller="Courses" asp-action="Create">
            
            Novo curso
        </a>
    </div>

    <div class="orizon-dashboard-grid is-auto-fit is-responsive">
        <article class="orizon-card orizon-card--elevated orizon-card--padding-md"><span>Cursos ativos</span><strong>@Model.ActiveCourses</strong><small>@Model.TotalCourses cadastrados</small></article>
        <article class="orizon-card orizon-card--elevated orizon-card--padding-md"><span>Rascunhos/arquivados</span><strong>@Model.DraftCourses</strong><small>Fora da biblioteca ativa</small></article>
        <article class="orizon-card orizon-card--elevated orizon-card--padding-md"><span>Alunos estudando</span><strong>@Model.StudyingStudents</strong><small>Tenant atual</small></article>
        <article class="orizon-card orizon-card--elevated orizon-card--padding-md"><span>Conclusoes no mes</span><strong>@Model.CompletionsThisMonth</strong><small>Aulas finalizadas</small></article>
        <article class="orizon-card orizon-card--elevated orizon-card--padding-md"><span>Certificados</span><strong>@Model.Certificates</strong><small>Emitidos</small></article>
        <article class="orizon-card orizon-card--elevated orizon-card--padding-md"><span>Engajamento</span><strong>@Model.AverageProgress%</strong><small>Progresso médio</small></article>
    </div>

    <form class="orizon-card orizon-card--padding-md orizon-form-grid orizon-items-end" method="get">
        <label class="ead-search-box">
            
            <input class="orizon-input" name="search" value="@Model.Search" type="search" placeholder="Pesquisar curso, trilha ou descrição..." />
        </label>
        <select class="orizon-select" name="active">
            <option value="">Todos os status</option>
            <option value="true" selected="@(Model.Active == true)">Publicado</option>
            <option value="false" selected="@(Model.Active == false)">Arquivado</option>
        </select>
        <select class="orizon-select" name="trail">
            <option value="">Todas as trilhas</option>
            @foreach (var trail in Model.Trails)
            {
                <option value="@trail" selected="@(Model.Trail == trail)">@trail</option>
            }
        </select>
        <button class="orizon-button orizon-button--outline orizon-button--neutral orizon-button--md" type="submit" data-tooltip="Aplicar filtros">Filtrar</button>
    </form>

    @if (Model.Courses.Items.Count == 0)
    {
        <section class="crm-empty-state">
            <div class="crm-empty-icon"></div>
            <strong>Nenhum curso encontrado</strong>
            <p>Crie cursos ou ajuste os filtros da biblioteca EAD.</p>
        </section>
    }
    else
    {
        <div class="orizon-dashboard-grid is-auto-fit is-responsive">
            @foreach (var course in Model.Courses.Items)
            {
                var statusClass = course.IsActive ? "orizon-badge--success" : "orizon-badge--warning";

                <article class="orizon-card orizon-card--elevated orizon-card--padding-none">
                    <div class="ead-course-visual">
                        
                    </div>

                    <div class="orizon-card__body orizon-grid orizon-gap-4">
                        <div class="ead-course-meta">
                            <span class="orizon-badge orizon-badge--info orizon-badge--md">@course.Trail</span>
                            <span class="orizon-badge orizon-badge--md @statusClass">@(course.IsActive ? "Publicado" : "Arquivado")</span>
                        </div>

                        <div>
                            <h2>@course.Title</h2>
                            <p>@course.Description</p>
                        </div>

                        <div class="ead-info-grid">
                            <div><small>Professor</small><strong>@course.Teacher</strong></div>
                            <div><small>Carga horária</small><strong>@course.WorkloadHours h</strong></div>
                            <div><small>Nível</small><strong>@course.Level</strong></div>
                            <div><small>Duração</small><strong>@course.DurationInMinutes min</strong></div>
                        </div>

                        <div class="rn-stack">
                            <div class="ead-progress-label"><span>Progresso médio</span><strong>@course.AverageProgress%</strong></div>
                            <div class="ead-progress-track"><div class="ead-progress-fill" style="width:@course.AverageProgress%;"></div></div>
                        </div>

                        <div class="ead-course-stats">
                            <span> @course.Lessons aulas</span>
                            <span> @course.Students alunos</span>
                            <span> @course.CompletionRate% conclusao</span>
                            <span> @course.Certificates certificados</span>
                        </div>

                        <div class="ead-card-actions">
                            <a class="orizon-button orizon-button--solid orizon-button--primary orizon-button--md" asp-area="EAD" asp-controller="Courses" asp-action="Details" asp-route-id="@course.Id">Abrir</a>
                            <a class="orizon-button orizon-button--outline orizon-button--neutral orizon-button--md" asp-area="EAD" asp-controller="Courses" asp-action="Content" asp-route-id="@course.Id">Conteudo</a>
                            <a class="orizon-button orizon-button--outline orizon-button--neutral orizon-button--md" asp-area="EAD" asp-controller="Courses" asp-action="Edit" asp-route-id="@course.Id">Editar</a>
                            <form asp-action="@(course.IsActive ? "Unpublish" : "Publish")" asp-route-id="@course.Id" method="post">
                                <button class="orizon-button orizon-button--outline orizon-button--neutral orizon-button--md" type="submit">@(course.IsActive ? "Despublicar" : "Publicar")</button>
                            </form>
                        </div>
                    </div>
                </article>
            }
        </div>

        @await Html.PartialAsync("~/Views/Shared/_Pagination.cshtml", Model.Courses)
    }
</section>

