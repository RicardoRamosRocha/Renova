@using Renova.Web.Areas.EAD.ViewModels.Courses
@model CourseContentViewModel
@{
    ViewData["Title"] = "Conteudo do Curso";
}

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <span>EAD / Conteudo</span>
            <h1>@Model.CourseTitle</h1>
            <p>Organize modulos, aulas, ordem, duracao e materiais do curso.</p>
        </div>
        <div class="rn-premium-actions">
            <a class="orizon-button orizon-button--outline orizon-button--neutral orizon-button--md" asp-action="Details" asp-route-id="@Model.CourseId">Detalhes</a>
            <a class="orizon-button orizon-button--solid orizon-button--primary orizon-button--md" asp-action="CreateModule" asp-route-courseId="@Model.CourseId">Novo modulo</a>
        </div>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="orizon-alert orizon-alert--success">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="orizon-alert orizon-alert--warning">@error</div>
    }

    @if (Model.Modules.Count == 0)
    {
        @await Html.PartialAsync("~/Views/Shared/_PremiumEmptyState.cshtml", new Renova.Web.ViewModels.PremiumEmptyStateViewModel
        {
            Icon = "ph ph-books",
            Title = "Curso sem conteudo",
            Description = "Crie o primeiro modulo para estruturar aulas, videos e atividades.",
            ActionText = "Criar modulo",
            ActionUrl = Url.Action("CreateModule", new { courseId = Model.CourseId })
        })
    }
    else
    {
        <div class="ead-module-list">
            @foreach (var module in Model.Modules)
            {
                var moduleDuration = module.Lessons.Sum(lesson => lesson.DurationInMinutes);
                var moduleAverage = module.Lessons.Count == 0 ? 0 : (int)Math.Round(module.Lessons.Average(lesson => lesson.AverageProgress));
                <details class="ead-module-card" open>
                    <summary>
                        <span>@module.Order</span>
                        <div>
                            <strong>@module.Title</strong>
                            <p>@module.Description</p>
                            <div class="ead-module-summary">
                                <small>@module.Lessons.Count aulas</small>
                                <small>@moduleDuration min</small>
                                <small>@moduleAverage% medio</small>
                            </div>
                        </div>
                        <div class="renova-action-buttons">
                            <form asp-action="MoveModule" asp-route-id="@module.Id" method="post"><input type="hidden" name="direction" value="up" /><button class="renova-action-btn" type="submit" data-tooltip="Subir"></button></form>
                            <form asp-action="MoveModule" asp-route-id="@module.Id" method="post"><input type="hidden" name="direction" value="down" /><button class="renova-action-btn" type="submit" data-tooltip="Descer"></button></form>
                            <a class="renova-action-btn" asp-action="EditModule" asp-route-id="@module.Id" data-tooltip="Editar modulo"></a>
                            <a class="renova-action-btn" asp-action="CreateLesson" asp-route-courseId="@Model.CourseId" asp-route-moduleId="@module.Id" data-tooltip="Nova aula"></a>
                            <form asp-action="DeleteModule" asp-route-id="@module.Id" method="post" onsubmit="return confirm('Remover este modulo? A operacao sera bloqueada se houver progresso de alunos.');"><button class="renova-action-btn danger" type="submit" data-tooltip="Remover modulo"></button></form>
                        </div>
                    </summary>

                    @if (module.Lessons.Count == 0)
                    {
                        <div class="medical-empty-line">Nenhuma aula cadastrada neste modulo.</div>
                    }
                    else
                    {
                        <div class="orizon-table-container">
                            <table class="orizon-table orizon-table--hoverable">
                                <thead>
                                    <tr><th>Aula</th><th>Tipo</th><th>Duracao</th><th>Alunos</th><th>Progresso</th><th class="text-end">Acoes</th></tr>
                                </thead>
                                <tbody>
                                @foreach (var lesson in module.Lessons)
                                {
                                    <tr>
                                        <td><strong class="renova-row-title">@lesson.Title</strong><small class="renova-row-subtitle">@lesson.Description</small></td>
                                        <td><span class="renova-status-badge info">@lesson.VideoProvider</span></td>
                                        <td><span class="renova-muted">@lesson.DurationInMinutes min</span></td>
                                        <td><span class="renova-muted">@lesson.Students</span></td>
                                        <td>
                                            <div class="ead-builder-progress">
                                                <strong>@lesson.AverageProgress%</strong>
                                                <div class="ead-progress-track"><div class="ead-progress-fill" style="width:@lesson.AverageProgress%;"></div></div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="renova-action-buttons">
                                                <a class="renova-action-btn" asp-action="Lesson" asp-route-id="@lesson.Id" data-tooltip="Abrir aula"></a>
                                                <a class="renova-action-btn" asp-action="EditLesson" asp-route-id="@lesson.Id" data-tooltip="Editar aula"></a>
                                                <form asp-action="MoveLesson" asp-route-id="@lesson.Id" method="post"><input type="hidden" name="direction" value="up" /><button class="renova-action-btn" type="submit" data-tooltip="Subir"></button></form>
                                                <form asp-action="MoveLesson" asp-route-id="@lesson.Id" method="post"><input type="hidden" name="direction" value="down" /><button class="renova-action-btn" type="submit" data-tooltip="Descer"></button></form>
                                                <form asp-action="DeleteLesson" asp-route-id="@lesson.Id" method="post" onsubmit="return confirm('Remover esta aula? A operacao sera bloqueada se houver progresso de alunos.');"><button class="renova-action-btn danger" type="submit" data-tooltip="Remover aula"></button></form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </details>
            }
        </div>
    }
</section>

