@{
    ViewData["Title"] = "Relatórios";
}

<section class="orizon-grid orizon-gap-6">
    <div class="orizon-card orizon-card--gradient orizon-card--padding-lg orizon-flex orizon-items-center orizon-justify-between orizon-gap-4">
        <div>
            <span>Inteligência operacional</span>
            <h1>Relatórios</h1>
            <p>Indicadores prontos para diretoria, equipe clínica, financeiro e EAD.</p>
        </div>
        <div class="rn-inline">
            <a class="orizon-button orizon-button--solid orizon-button--primary orizon-button--md" href="#">Exportar PDF</a>
            <a class="orizon-button orizon-button--outline orizon-button--neutral orizon-button--md" href="#">Exportar Excel</a>
        </div>
    </div>

    <div class="orizon-dashboard-grid is-auto-fit is-responsive">
        <article class="orizon-card orizon-card--elevated orizon-card--padding-md orizon-grid orizon-gap-3">
            <span class="demo-card-icon"></span>
            <h2>Relatório de Acolhidos</h2>
            <p class="rn-muted">Entradas, altas, status, evolução de tratamento e perfil institucional.</p>
            <a class="orizon-button orizon-button--outline orizon-button--neutral orizon-button--md" href="#">Abrir relatório</a>
        </article>
        <article class="orizon-card orizon-card--elevated orizon-card--padding-md orizon-grid orizon-gap-3">
            <span class="demo-card-icon"></span>
            <h2>Relatório Financeiro</h2>
            <p class="rn-muted">Receita, despesas, inadimplência, cobranças e previsão de caixa.</p>
            <a class="orizon-button orizon-button--outline orizon-button--neutral orizon-button--md" href="#">Abrir relatório</a>
        </article>
        <article class="orizon-card orizon-card--elevated orizon-card--padding-md orizon-grid orizon-gap-3">
            <span class="demo-card-icon"></span>
            <h2>Relatório Clínico</h2>
            <p class="rn-muted">Atendimentos, evoluções, riscos, documentos e produtividade técnica.</p>
            <a class="orizon-button orizon-button--outline orizon-button--neutral orizon-button--md" href="#">Abrir relatório</a>
        </article>
        <article class="orizon-card orizon-card--elevated orizon-card--padding-md orizon-grid orizon-gap-3">
            <span class="demo-card-icon"></span>
            <h2>Relatório EAD</h2>
            <p class="rn-muted">Engajamento, progresso, certificados, cursos mais acessados e trilhas.</p>
            <a class="orizon-button orizon-button--outline orizon-button--neutral orizon-button--md" href="#">Abrir relatório</a>
        </article>
    </div>

    <section class="orizon-card orizon-card--padding-lg orizon-grid orizon-gap-4">
        <div class="orizon-flex orizon-items-center orizon-justify-between">
            <div><span class="rn-eyebrow">Resumo executivo</span><h2>Indicadores do mês</h2></div>
        </div>
        <div class="orizon-dashboard-grid is-auto-fit is-responsive">
            <article class="orizon-card orizon-card--elevated orizon-card--padding-md"><span>Taxa de ocupação</span><strong>87%</strong><small>Dentro da meta</small></article>
            <article class="orizon-card orizon-card--elevated orizon-card--padding-md"><span>Alta terapêutica</span><strong>18</strong><small>Previstas no mês</small></article>
            <article class="orizon-card orizon-card--elevated orizon-card--padding-md"><span>Engajamento EAD</span><strong>74%</strong><small>Alunos ativos</small></article>
        </div>
    </section>
</section>

